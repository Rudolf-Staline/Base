    "clean": "rm -rf dist .turbo node_modules/.vite"
  },
  "dependencies": {
    "@basekit/ui": "workspace:*",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@vitejs/plugin-react": "latest"
  }
}
